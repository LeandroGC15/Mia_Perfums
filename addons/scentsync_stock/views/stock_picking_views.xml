<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_scentsync" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.scentsync</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Insertamos nuestro campo personalizado de urgencia justo después del campo 'origin' (Documento Origen) -->
            <xpath expr="//field[@name='origin']" position="after">
                <field name="scentsync_urgencia" widget="radio" options="{'horizontal': true}"/>
            </xpath>
        </field>
    </record>
</odoo>
