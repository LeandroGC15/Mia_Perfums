<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_scentsync" model="ir.ui.view">
        <field name="name">account.move.form.inherit.scentsync</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Insertamos nuestro campo personalizado justo después del campo 'ref' (Referencia) -->
            <xpath expr="//field[@name='ref']" position="after">
                <field name="scentsync_observacion"/>
            </xpath>
        </field>
    </record>
</odoo>
