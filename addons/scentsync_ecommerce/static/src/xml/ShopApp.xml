<?xml version="1.0" encoding="utf-8"?>
<templates>

  <t t-name="scentsync.ShopApp">
    <!-- Header -->
    <header class="ss-header">
      <div class="ss-header__inner">
        <a href="/shop" class="ss-logo">
          <span class="ss-logo__icon">✦</span>
          <span class="ss-logo__name">ScentSync</span>
        </a>
        <nav class="ss-nav">
          <button class="ss-nav__item" t-on-click="() => this.state.view = 'catalog'">Catálogo</button>
        </nav>
        <button class="ss-cart-btn" t-on-click="toggleCart">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 01-8 0"/>
          </svg>
          <span class="ss-cart-btn__badge" t-if="cartCount > 0" t-esc="cartCount"/>
        </button>
      </div>
    </header>

    <!-- Contenido principal -->
    <main class="ss-main">
      <t t-if="state.view === 'catalog'">
        <ProductGrid
          products="state.products"
          loading="state.loading"
          families="FAMILIES"
          activeFamily="state.activeFamily"
          searchQuery="state.searchQuery"
          onFamilyChange.bind="onFamilyChange"
          onSearch.bind="onSearch"
          onViewDetail.bind="onViewDetail"
          onAddToCart.bind="addToCart"
        />
      </t>
      <t t-elif="state.view === 'detail'">
        <ProductDetail
          product="state.selectedProduct"
          onBack="() => this.state.view = 'catalog'"
          onAddToCart.bind="addToCart"
        />
      </t>
      <t t-elif="state.view === 'checkout'">
        <CheckoutForm
          cart="state.cart"
          cartTotal="cartTotal"
          onBack="() => this.state.view = 'catalog'"
          onOrderComplete.bind="onOrderComplete"
        />
      </t>
      <t t-elif="state.view === 'success'">
        <div class="ss-success">
          <div class="ss-success__icon">🎉</div>
          <h2 class="ss-success__title">¡Pedido Enviado!</h2>
          <p class="ss-success__sub">Tu pedido <strong t-esc="state.lastOrder.order_name"/> ha sido registrado.</p>
          <a t-att-href="state.lastOrder.whatsapp_url" target="_blank" class="ss-btn ss-btn--whatsapp">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Confirmar por WhatsApp
          </a>
          <button class="ss-btn ss-btn--outline" t-on-click="() => this.state.view = 'catalog'">Seguir comprando</button>
        </div>
      </t>
    </main>

    <!-- Sidebar del carrito -->
    <CartSidebar
      open="state.cartOpen"
      cart="state.cart"
      cartTotal="cartTotal"
      onClose="() => this.state.cartOpen = false"
      onUpdate.bind="updateCartItem"
      onRemove.bind="removeFromCart"
      onCheckout="() => { this.state.cartOpen = false; this.state.view = 'checkout'; }"
    />

    <!-- Overlay del carrito -->
    <div t-if="state.cartOpen" class="ss-overlay" t-on-click="() => this.state.cartOpen = false"/>
  </t>

</templates>
